<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.vita</groupId>
    <artifactId>be-data-stock</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>be-vita</name>
    <description>Be Vita Parent POM</description>

    <properties>
        <vita.version>1.0.0-SNAPSHOT</vita.version>
        <vita.starters.version>1.0.0-SNAPSHOT</vita.starters.version>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <springboot.version>3.5.0</springboot.version>
        <lombok.version>1.18.28</lombok.version>
        <dynamic.version>4.3.1</dynamic.version>
        <HikariCP.version>5.0.1</HikariCP.version>
        <mysql.version>8.0.32</mysql.version>
        <redisson.version>3.50.0</redisson.version>
        <mybatis-plus.version>3.5.12</mybatis-plus.version>
        <fastjson2.version>2.0.52</fastjson2.version>
        <hutool-all.version>5.8.25</hutool-all.version>
        <guava.version>33.2.1-jre</guava.version>
        <bcprov.version>1.79</bcprov.version>
        <sa-token.version>1.44.0</sa-token.version>
        <warm-flow.version>1.8.8</warm-flow.version>
    </properties>

    <modules>
        <module>vita-common</module>
        <module>vita-service</module>
        <module>vita-generator</module>
        <module>vita-starters</module>
        <module>vita-admin</module>
        <module>vita-scheduler</module>
        <module>vita-openapi</module>
        <module>vita-workflow</module>
        <module>vita-app</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM，统一管理所有 Spring Boot 依赖版本 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${springboot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Lombok，简化 Java Bean 代码 -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>

            <!-- 动态数据源，支持运行时切换主从/多数据源 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>dynamic-datasource-spring-boot3-starter</artifactId>
                <version>${dynamic.version}</version>
            </dependency>

            <!-- 数据库连接池，Spring Boot 默认使用 -->
            <dependency>
                <groupId>com.zaxxer</groupId>
                <artifactId>HikariCP</artifactId>
                <version>${HikariCP.version}</version>
            </dependency>

            <!-- MySQL JDBC 驱动 -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql.version}</version>
            </dependency>

            <!-- Redis 客户端，支持分布式锁、缓存等 -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>

            <!-- MyBatis-Plus ORM 框架 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- MyBatis-Plus SQL 解析插件 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- MyBatis-Plus 代码生成器，仅 vita-generator 使用 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-generator</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- JSON 序列化/反序列化工具 -->
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson2.version}</version>
            </dependency>

            <!-- Java 工具类集合 -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool-all.version}</version>
            </dependency>

            <!-- Google 工具类集合，主要用于缓存、集合等 -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>

            <!-- 加密算法库，支持国密等算法 -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bcprov.version}</version>
            </dependency>

            <!-- Sa-Token 权限认证框架 -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot3-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <!-- Sa-Token 整合 Redis，使用 RedisTemplate 存储会话 -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-redis-template</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <!-- Sa-Token 整合 JWT，用于无状态 Token 认证 -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-jwt</artifactId>
                <version>${sa-token.version}</version>
            </dependency>

            <!-- 工作流warm-flow模块 -->
            <dependency>
                <groupId>org.dromara.warm</groupId>
                <artifactId>warm-flow-mybatis-plus-sb3-starter</artifactId>
                <version>${warm-flow.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dromara.warm</groupId>
                <artifactId>warm-flow-plugin-ui-sb-web</artifactId>
                <version>${warm-flow.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dromara.warm</groupId>
                <artifactId>warm-flow-plugin-ui-core</artifactId>
                <version>${warm-flow.version}</version>
            </dependency>

            <!-- 公共基础模块 -->
            <dependency>
                <groupId>com.vita</groupId>
                <artifactId>vita-common</artifactId>
                <version>${vita.version}</version>
            </dependency>

            <!-- 业务服务层模块 -->
            <dependency>
                <groupId>com.vita</groupId>
                <artifactId>vita-service</artifactId>
                <version>${vita.version}</version>
            </dependency>

            <!-- 工作流基础设施模块 -->
            <dependency>
                <groupId>com.vita</groupId>
                <artifactId>vita-workflow</artifactId>
                <version>${vita.version}</version>
            </dependency>

            <!-- 验证码 Starter -->
            <dependency>
                <groupId>com.vita</groupId>
                <artifactId>vita-captcha-spring-boot-starter</artifactId>
                <version>${vita.starters.version}</version>
            </dependency>
            <!-- 文件上传/存储 Starter -->
            <dependency>
                <groupId>com.vita</groupId>
                <artifactId>vita-file-spring-boot-starter</artifactId>
                <version>${vita.starters.version}</version>
            </dependency>
            <!-- 国际化 -->
            <dependency>
                <groupId>com.vita</groupId>
                <artifactId>vita-i18n-spring-boot-starter</artifactId>
                <version>${vita.starters.version}</version>
            </dependency>
            <!-- 导入/导出 -->
            <dependency>
                <groupId>com.vita</groupId>
                <artifactId>vita-poi-spring-boot-starter</artifactId>
                <version>${vita.starters.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${springboot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>public</id>
            <name>aliyun nexus</name>
            <url>https://maven.aliyun.com/nexus/content/groups/public/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>public</id>
            <name>aliyun nexus</name>
            <url>https://maven.aliyun.com/nexus/content/groups/public/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

</project>
