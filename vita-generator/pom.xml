<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.vita</groupId>
        <artifactId>be-data-stock</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>vita-generator</artifactId>
    <name>vita-generator</name>
    <packaging>jar</packaging>
    <description>Code Generator Module for Vita Project</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <velocity-engine-core.version>2.4.1</velocity-engine-core.version>
        <commons-lang3.version>3.16.0</commons-lang3.version>
    </properties>

    <dependencies>
        <!-- 公共基础模块 -->
        <dependency>
            <groupId>com.vita</groupId>
            <artifactId>vita-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- MyBatis-Plus 代码生成器 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-generator</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.commons</groupId>
                    <artifactId>commons-lang3</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Velocity 模板引擎，代码生成使用 -->
        <dependency>
            <groupId>org.apache.velocity</groupId>
            <artifactId>velocity-engine-core</artifactId>
            <version>${velocity-engine-core.version}</version>
        </dependency>

        <!-- Apache Commons Lang3，代码生成使用 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${commons-lang3.version}</version>
        </dependency>
    </dependencies>
</project>
