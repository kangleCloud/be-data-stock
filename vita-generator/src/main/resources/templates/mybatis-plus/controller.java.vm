package ${package.Controller};

#if(${superControllerClassPackage})
import ${superControllerClassPackage};
#end
import ${commonPackage}.CommonResult;
import ${commonPackage}.page.PageResponse;
import ${dtoPackage}.${entity}CreateDto;
import ${dtoPackage}.${entity}DeletedDto;
import ${dtoPackage}.${entity}SearchDto;
import ${dtoPackage}.${entity}UpdateDto;
import ${package.Service}.${table.serviceName};
import ${voPackage}.${entity}DetailVo;
import ${voPackage}.${entity}ListVo;
import ${voPackage}.${entity}PageVo;
import ${basePackage}.repeat.annotation.RepeatSubmit;
import jakarta.validation.Valid;
import org.springframework.validation.annotation.Validated;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import java.util.List;

/**
 * @BelongsProject: ${projectName}
 * @BelongsPackage: ${package.Controller}
 * @Author ${author}
 * @CreateTime ${date}
 * @Description: ${table.comment} 控制器
 * @version 1.0
 */
@Validated
@RestController
@RequestMapping("/#if(${moduleRoute})${moduleRoute}/#end${table.entityPath}")
#if(${kotlin})
class ${table.controllerName}#if(${superControllerClass}) : ${superControllerClass}()#end
#else
#if(${superControllerClass})
public class ${table.controllerName} extends ${superControllerClass} {
#else
public class ${table.controllerName} {
#end

    /**
     * ${table.comment} 服务。
     */
    private final ${table.serviceName} ${table.entityPath}Service;

    public ${table.controllerName}(${table.serviceName} ${table.entityPath}Service) {
        this.${table.entityPath}Service = ${table.entityPath}Service;
    }

    /**
     * 新增数据。
     *
     * @param createDto 创建请求对象
     * @return 新增记录ID
     */
    @RepeatSubmit
    @PostMapping("/add")
    public CommonResult<Long> create(@RequestBody @Valid ${entity}CreateDto createDto) {
        return CommonResult.success(${table.entityPath}Service.create(createDto));
    }

    /**
     * 更新数据。
     *
     * @param updateDto 更新请求对象
     * @return 更新结果
     */
    @RepeatSubmit
    @PostMapping("/update")
    public CommonResult<Boolean> update(@RequestBody @Valid ${entity}UpdateDto updateDto) {
        ${table.entityPath}Service.update(updateDto);
        return CommonResult.success(true);
    }

    /**
     * 删除数据。
     *
     * @param deletedDto 删除请求对象
     * @return 删除结果
     */
    @RepeatSubmit
    @PostMapping("/delete")
    public CommonResult<Boolean> delete(@RequestBody @Valid ${entity}DeletedDto deletedDto) {
        ${table.entityPath}Service.delete(deletedDto);
        return CommonResult.success(true);
    }

    /**
     * 查询详情。
     *
     * @param id 主键ID
     * @return 详情对象
     */
    @GetMapping("/getDetail")
    public CommonResult<${entity}DetailVo> getDetail(@RequestParam("id") Long id) {
        return CommonResult.success(${table.entityPath}Service.get(id));
    }

    /**
     * 列表查询。
     *
     * @param searchDto 查询条件
     * @return 列表数据
     */
    @GetMapping("/list")
    public CommonResult<List<${entity}ListVo>> list(@Valid ${entity}SearchDto searchDto) {
        return CommonResult.success(${table.entityPath}Service.list(searchDto));
    }

    /**
     * 分页查询。
     *
     * @param searchDto 分页查询条件
     * @return 分页数据
     */
    @GetMapping("/page")
    public CommonResult<PageResponse<${entity}PageVo>> page(@Valid ${entity}SearchDto searchDto) {
        return CommonResult.success(${table.entityPath}Service.page(searchDto));
    }
}
#end
