package ${package.Entity};

#foreach($pkg in ${importEntityFrameworkPackages})
import ${pkg};
#end

#foreach($pkg in ${importEntityJavaPackages})
import ${pkg};
#end
#if(${entityLombokModel} && ${superEntityClass})
import lombok.EqualsAndHashCode;
#end

/**
 * @BelongsProject: ${projectName}
 * @BelongsPackage: ${package.Entity}
 * @Author ${author}
 * @CreateTime ${date}
 * @Description: ${table.comment} 实体类
 * @version 1.0
 */
#foreach($an in ${entityClassAnnotations})
${an.displayName}
#end
#if(${entityLombokModel} && ${superEntityClass})
@EqualsAndHashCode(callSuper = true)
#end
#if(${superEntityClass})
public class ${entity} extends ${superEntityClass}#if(${activeRecord})<${entity}>#end {
#elseif(${activeRecord})
public class ${entity} extends Model<${entity}> {
#elseif(${entitySerialVersionUID})
public class ${entity} implements Serializable {
#else
public class ${entity} {
#end
#if(${entitySerialVersionUID})

    #if(${entitySerialAnnotation})
    @Serial
    #end
    private static final long serialVersionUID = 1L;
#end
#foreach($field in ${table.fields})

#if("$!field.comment" != "")
  #if(${entityFieldUseJavaDoc})
    /**
     * ${field.comment}
     */
  #end
#end
#foreach($an in ${field.annotationAttributesList})
    ${an.displayName}
#end
    private ${field.propertyType} ${field.propertyName};
#end
}
