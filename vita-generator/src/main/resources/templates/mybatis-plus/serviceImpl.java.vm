package ${package.ServiceImpl};

import cn.hutool.core.bean.BeanUtil;
import cn.hutool.core.util.StrUtil;
import ${superServiceImplClassPackage};
import ${commonPackage}.exception.GlobalErrorCode;
import ${commonPackage}.exception.ServiceException;
import ${commonPackage}.page.PageResponse;
import ${basePackage}.mybatis.wrapper.LambdaQueryWrapperX;
import ${dtoPackage}.${entity}CreateDto;
import ${dtoPackage}.${entity}DeletedDto;
import ${dtoPackage}.${entity}SearchDto;
import ${dtoPackage}.${entity}UpdateDto;
import ${package.Entity}.${entity};
import ${package.Mapper}.${table.mapperName};
import ${package.Service}.${table.serviceName};
import ${voPackage}.${entity}DetailVo;
import ${voPackage}.${entity}ListVo;
import ${voPackage}.${entity}PageVo;
import org.springframework.beans.BeanUtils;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.List;

/**
 * @BelongsProject: ${projectName}
 * @BelongsPackage: ${package.ServiceImpl}
 * @Author ${author}
 * @CreateTime ${date}
 * @Description: ${table.comment} Service 实现
 * @version 1.0
 */
@Service
#if(${kotlin})
open class ${table.serviceImplName} : ${superServiceImplClass}<${table.mapperName}, ${entity}>(), ${table.serviceName} {

}
#else
public class ${table.serviceImplName} extends ${superServiceImplClass}<${table.mapperName}, ${entity}> implements ${table.serviceName} {

    private final ${table.mapperName} ${table.entityPath}Mapper;

    public ${table.serviceImplName}(${table.mapperName} ${table.entityPath}Mapper) {
        this.${table.entityPath}Mapper = ${table.entityPath}Mapper;
    }

    /**
     * 新增数据并返回主键ID。
     *
     * @param createDto 创建请求对象
     * @return 新增记录ID
     */
    @Override
    @Transactional(rollbackFor = Exception.class)
    public Long create(${entity}CreateDto createDto) {
        if (createDto == null) {
            throw new ServiceException(GlobalErrorCode.BAD_REQUEST);
        }
        ${entity} data = new ${entity}();
        BeanUtils.copyProperties(createDto, data);
        ${table.entityPath}Mapper.insert(data);
        return data.getId();
    }

    /**
     * 更新指定数据。
     *
     * @param updateDto 更新请求对象
     */
    @Override
    @Transactional(rollbackFor = Exception.class)
    public void update(${entity}UpdateDto updateDto) {
        if (updateDto == null || updateDto.getId() == null) {
            throw new ServiceException(GlobalErrorCode.BAD_REQUEST);
        }
        getRequiredEntity(updateDto.getId());
        ${entity} data = new ${entity}();
        BeanUtils.copyProperties(updateDto, data);
        ${table.entityPath}Mapper.updateById(data);
    }

    /**
     * 删除指定数据。
     *
     * @param deletedDto 删除请求对象
     */
    @Override
    @Transactional(rollbackFor = Exception.class)
    public void delete(${entity}DeletedDto deletedDto) {
        if (deletedDto == null || deletedDto.getId() == null) {
            throw new ServiceException(GlobalErrorCode.BAD_REQUEST);
        }
        getRequiredEntity(deletedDto.getId());
        ${table.entityPath}Mapper.deleteById(deletedDto.getId());
    }

    /**
     * 查询单条数据。
     *
     * @param id 主键ID
     * @return 详情对象
     */
    @Override
    public ${entity}DetailVo get(Long id) {
        ${entity} data = getRequiredEntity(id);
        return BeanUtil.copyProperties(data, ${entity}DetailVo.class);
    }

    /**
     * 列表查询。
     *
     * @param searchDto 查询条件
     * @return 列表VO
     */
    @Override
    public List<${entity}ListVo> list(${entity}SearchDto searchDto) {
        List<${entity}> dataList = ${table.entityPath}Mapper.selectList(buildQueryWrapper(searchDto));
        return BeanUtil.copyToList(dataList, ${entity}ListVo.class);
    }

    /**
     * 分页查询。
     *
     * @param searchDto 分页查询条件
     * @return 分页VO结果
     */
    @Override
    public PageResponse<${entity}PageVo> page(${entity}SearchDto searchDto) {
        if (searchDto == null) {
            searchDto = new ${entity}SearchDto();
        }
        PageResponse<${entity}> selectPage = ${table.entityPath}Mapper.selectPage(searchDto, buildQueryWrapper(searchDto));
        PageResponse<${entity}PageVo> pageResponse = new PageResponse<>();
        pageResponse.setList(BeanUtil.copyToList(selectPage.getList(), ${entity}PageVo.class));
        pageResponse.setTotal(selectPage.getTotal());
        return pageResponse;
    }

    /**
     * 构造列表查询条件。
     *
     * @param searchDto 查询条件
     * @return 查询条件构造器
     */
    private LambdaQueryWrapperX<${entity}> buildQueryWrapper(${entity}SearchDto searchDto) {
        LambdaQueryWrapperX<${entity}> queryWrapper = new LambdaQueryWrapperX<>();
        if (searchDto != null && StrUtil.isNotBlank(searchDto.getKeyword())) {
            // TODO 根据业务字段补充关键字查询条件
        }
        queryWrapper.orderByDesc(${entity}::getId);
        return queryWrapper;
    }

    /**
     * 查询并校验数据存在性。
     *
     * @param id 主键ID
     * @return 实体对象
     */
    private ${entity} getRequiredEntity(Long id) {
        if (id == null) {
            throw new ServiceException(GlobalErrorCode.BAD_REQUEST);
        }
        ${entity} data = ${table.entityPath}Mapper.selectById(id);
        if (data == null) {
            throw new ServiceException(GlobalErrorCode.NOT_FOUND);
        }
        return data;
    }
}
#end
