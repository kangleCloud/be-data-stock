<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vita.system.sysRole.mapper.SysRoleMapper">

    <select id="selectRoleCodesByIds" resultType="java.lang.String">
        SELECT role_code
        FROM sys_role
        WHERE is_deleted = 0
          AND role_code IS NOT NULL
          AND role_code != ''
        <if test="status != null">
          AND status = #{status}
        </if>
        <if test="roleIds != null and roleIds.size() > 0">
          AND id IN
          <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
            #{roleId}
          </foreach>
        </if>
        ORDER BY role_sort ASC, id ASC
    </select>
</mapper>
